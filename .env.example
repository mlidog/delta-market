# ============ 应用 ============
APP_NAME=三角洲物价观察
APP_ENV=dev
LOG_LEVEL=INFO

# ============ 数据源 ============
# mock  = 使用本地模拟数据（默认，无需 Token，可离线开发）
# delta = 使用"三角洲数据帝"真实 API（需要 DELTA_API_TOKEN）
DATA_SOURCE=mock

# 三角洲数据帝 API（待补充文档后填写）
DELTA_API_BASE_URL=
DELTA_API_TOKEN=
DELTA_API_TIMEOUT=10

# ============ 数据库 ============
# MVP 使用 SQLite；后续切换 PostgreSQL/TimescaleDB 只需改这一行
DATABASE_URL=sqlite:///./data/app.db

# ============ 采集调度 ============
COLLECTOR_TIMEZONE=Asia/Shanghai
# 每日采集时刻（小时，逗号分隔）
COLLECTOR_CRON_HOURS=0,16,22
# 是否在本进程内启动定时采集（多 worker 部署时只应让一个进程开启）
SCHEDULER_ENABLED=true
# 单次请求最大尝试次数（含首次），采用指数退避 + 抖动
COLLECTOR_RETRY_TIMES=3
# 应用启动时是否立即补采一次（避免看板为空）
COLLECTOR_RUN_ON_STARTUP=true
# 物品基础信息刷新间隔（天），0 表示每轮都刷新
COLLECTOR_ITEM_REFRESH_DAYS=7
# 采集完成后是否把静态数据推送到 GitHub（GitHub Pages 的数据来源）
PUBLISHER_ENABLED=true
